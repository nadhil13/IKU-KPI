{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/v1/[...route]" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
