APP_ENV=production
APP_URL=https://performa.itpln.ac.id
FRONTEND_URL=https://performa.itpln.ac.id
BACKEND_PORT=4000

# ============================================================================
# KONFIGURASI DATABASE SERVER BPTI ITPLN (STANDAR KEAMANAN CVE 2026)
# Pilihan Utama (Recommended): PostgreSQL 15 / 16 / 17 LTS (DB_CONNECTION=pgsql)
# Pilihan Alternatif: MariaDB v12 / MySQL 8.4 LTS (DB_CONNECTION=mysql)
# Skema DDL siap pakai tersedia di:
#   - backend/database/schema.postgresql.sql
#   - backend/database/schema.mysql.sql
# ============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=iku_kpi_itpln
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSL_MODE=prefer

# Jika menggunakan MariaDB v12 / MySQL 8.4 LTS di server BPTI:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=iku_kpi_itpln
# DB_USERNAME=itpln_kpi_user
# DB_PASSWORD=
