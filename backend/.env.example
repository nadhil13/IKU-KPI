# Konfigurasi Lingkungan Backend PERFORMA KPI & IKU ITPLN
NODE_ENV=production
HOST=127.0.0.1
PORT=8000

# Lokasi Basis Data SQLite WAL (kosongkan untuk memakai path bawaan storage/app/private/performa_itpln.sqlite)
PERFORMA_DB_PATH=

# Kunci Rahasia Kriptografi Token Sesi (HMAC-SHA256)
# Wajib diganti dengan string acak minimal 64 karakter pada server produksi
APP_SECRET=ganti_dengan_64_karakter_hex_acak_kriptografis_di_server_produksi_bpti
JWT_SECRET=

# Daftar Origin Frontend yang Diizinkan oleh CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=https://performa.itpln.ac.id,http://localhost:5173,http://127.0.0.1:5173

# Konfigurasi Web Push VAPID (RFC 8292 & RFC 8291)
VAPID_SUBJECT=mailto:prp@itpln.ac.id
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PRIVATE_JWK=

# Konfigurasi Gateway Email Resmi (Resend API atau Webhook SMTP Internal)
SMTP_FROM_EMAIL=performa-prp@itpln.ac.id
RESEND_API_KEY=
SMTP_WEBHOOK_URL=
